#!/usr/bin/env bash
#
# Dump and merge all _scans.tsv with reprostim_* metadata as single .tsv
#
cd "$(dirname $0)"/..

set -eu

#find . \( -type f -o -type l \) -name '*_scans.tsv' | xargs cat

# dump aggregated header
printf 'no\tses_no\tscans_tsv\tfilename\tacq_time\toperator\trandstr\treprostim_path\treprostim_offset\treprostim_buffer_before\treprostim_buffer_after\n'

ses_no=0
find . \( -type f -o -type l \) -name '*_scans.tsv' -print0 |
while IFS= read -r -d '' f; do
	if head -n1 "$f" | grep -q 'reprostim_'; then
		ses_no=$((ses_no + 1))
		tail -n +2 "$f" | awk -v pre="$f" -v s="$ses_no" '{print s "\t" pre "\t" $0}'
	fi
done | awk '{print NR "\t" $0}'
