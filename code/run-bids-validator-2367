#!/usr/bin/env bash
#
# Execute BIDS validator against dbic-QA using schema:
#   https://bids-specification--2022.org.readthedocs.build/en/2022/schema.json
#
# Reference PR: https://github.com/bids-standard/bids-specification/pull/2022
#
set -eu

name=$(basename $0)
cd "$(dirname $0)"/..

dataset_dir="$(pwd)"

lock_file="$HOME/.run/${name}.lock"

# Ensure the lock directory exists
mkdir -p "$HOME/.run"

{
	mkdir -p logs/bids-validator
	mkdir -p derivatives
	flock -n 200 || { echo "$name job is already running for $0." 2>&1 ; exit 1; }
	REPRONIM_USE_DUCT=1 DUCT_OUTPUT_PREFIX='logs/bids-validator/{datetime_filesafe}-{pid}_' \
	# ATM ignore failure status if validator fails. 
	# TODO: monitor and make specific to cmd: https://github.com/datalad/datalad/issues/7902
	datalad --on-failure ignore \
		containers-run -m "Run code/run-bids-validator-2022 on ${dataset_dir}" \
		-n bids-validator \
		--input "${dataset_dir}" \
		--output "logs/bids-validator/*.*" \
		--output "derivatives/bids-validator.json" \
		-- "${dataset_dir}" \
			--schema https://bids-specification--2022.org.readthedocs.build/en/2022/schema.json \
			--ignoreNiftiHeaders \
			--verbose \
			--format json \
			-o "derivatives/bids-validator.json"

} 200>"$lock_file"
