#!/usr/bin/env bash
#
# To be ran periodically, e.g. daily or manually
#
name=$(basename $0)

cd "$(dirname $0)"/..
pwd

if [ -n "$1" ]; then
	files=("$@")
else
	files=("sub-qa64/ses-20250811")
	if [ ! -e "${files[0]}" ]; then
		echo "$name: default directory does not exist, nothing to do: ${files[0]}" >&2
		exit 0
	fi
fi

session_dir="sub-*/ses-*"
# When targeting a single session directory (the default, or one explicit
# arg) or a glob, use it directly instead of the glob pattern
if [ "${#files[@]}" -eq 1 ] ; then
	session_dir="${files[0]}"
fi


set -eu

lock_file="$HOME/.run/${name}.lock"

# Ensure the lock directory exists
mkdir -p "$HOME/.run"

# BIDS_INJECT_EXTRA_ARGS: optional env var with extra bids-inject options
# e.g. "--metadata-only":
#
# BIDS_INJECT_EXTRA_ARGS="--metadata-only" code/reprostim-bids-inject
#

{
	mkdir -p logs/bids-inject
	flock -n 200 || { echo "$name job is already running for $0." 2>&1 ; exit 1; }
	REPRONIM_USE_DUCT=1 DUCT_OUTPUT_PREFIX='logs/bids-inject/{datetime_filesafe}-{pid}_' \
	datalad containers-run -m "Run code/reprostim-bids-inject on ${session_dir} ${BIDS_INJECT_EXTRA_ARGS:+[$BIDS_INJECT_EXTRA_ARGS]}" \
		-n repronim-reprostim \
		--input sourcedata/reprostim-reproiner \
		--input "${session_dir}" \
		--output "logs/bids-inject/*.*" \
		--output "${session_dir}/*_scans.tsv" \
		--output "${session_dir}/*/*_audiovideo*.*" \
		--output "${session_dir}/*/*_audio*.*" \
		--output "${session_dir}/*/*_video*.*" \
			bids-inject \
			  -f "sourcedata/reprostim-reproiner/videos.tsv" \
			  -r -k no -l nearby -b 3 -a 3 -q none  \
			  --verbose \
			  ${BIDS_INJECT_EXTRA_ARGS:-} \
			  "{inputs[1]}"

	# TODO: use -q embed-existing once we implement it for better timing
} 200>"$lock_file"
